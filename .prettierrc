{
    "semi": true,
    "singleQuote": true,
    "jsxSingleQuote": false,
    "tabWidth": 2,
    "useTabs": false,
    "printWidth": 100,
    "trailingComma": "all",
    "bracketSpacing": true,
    "bracketSameLine": false,
    "arrowParens": "always",
    "endOfLine": "auto",
    "plugins": ["prettier-plugin-tailwindcss", "prettier-plugin-organize-imports"]
}